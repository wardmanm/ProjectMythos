        "npc.jory",
      ],
      "gameTime": 2456610,
      "id": "00000000-0000-4000-8000-000000000013",
      "importance": 7,
      "kind": "event",
      "mentionedIds": [],
      "placeId": "place.harbor",
      "tags": [
        "merrows-luck",
      ],
      "text": "The Merrow's Luck slipped out of Brinemoor harbor after dark with no lanterns lit, riding low in the water on a flat calm sea.",
      "turnId": "00000000-0000-4000-8000-000000000002",
      "witnessIds": [
        "npc.jory",
        "npc.tomas",
      ],
    },
    "type": "observation.add",
