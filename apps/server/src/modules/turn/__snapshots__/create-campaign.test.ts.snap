      "claim": {
        "aboutObservationId": "00000000-0000-4000-8000-000000000006",
        "audienceIds": [
          "pc.wren",
        ],
        "content": "The Merrow's Luck was lost with all hands in a squall off the Point on the night of September 2nd, and Jory is presumed drowned.",
