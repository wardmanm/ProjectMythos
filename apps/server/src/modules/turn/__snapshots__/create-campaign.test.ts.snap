      "mentionedIds": [],
      "placeId": "place.the-point",
      "tags": [
        "merrows-luck",
        "jory",
        "secret",
      ],
      "text": "The overloaded Merrow's Luck foundered in calm water off the Point. The Night Traders' cutter waiting to meet her pulled Jory Ashby from the sea and carried him away up the coast; the other four crew drowned.",
      "turnId": "00000000-0000-4000-8000-000000000002",
      "witnessIds": [
        "npc.jory",
      ],
    },
    "type": "observation.add",
