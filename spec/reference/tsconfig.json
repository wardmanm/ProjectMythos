{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@mythos/contracts": ["./contracts/index.ts"],
      "@mythos/contracts/content": ["./contracts/content/index.ts"]
    }
  },
  "include": ["contracts", "core", "server-types", "scripts", "test-support", "vitest.config.ts"]
}
